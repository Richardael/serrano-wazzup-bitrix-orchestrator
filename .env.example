# ============================================================
# Serrano Wazzup-Bitrix Orchestrator — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or real secrets to the repository.

# General
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/serrano_orchestrator

# Bitrix24
BITRIX24_WEBHOOK_BASE_URL=https://your-portal.bitrix24.com/rest/1/your-token/
BITRIX24_DEFAULT_RESPONSIBLE_ID=1
BITRIX24_LEAD_INITIAL_STATUS=NEW

# Assignment — round-robin vendor IDs (comma-separated)
VENDOR_IDS=206,268,308

# Wazzup
WAZZUP_WEBHOOK_ID=changeme
WAZZUP_WEBHOOK_BEARER_TOKEN=changeme
WAZZUP_API_KEY=

# Bot internal relay. Configure both values together; use a long random shared secret.
BOT_INTERNAL_BASE_URL=http://localhost:3002
ORCHESTRATOR_SHARED_SECRET=

# Features
AUTOMATED_CHATBOT_ENABLED=false
STORE_MESSAGE_BODY=false
EVENT_RETENTION_DAYS=30
MAX_WEBHOOK_BODY_BYTES=1048576
JOB_MAX_ATTEMPTS=5
