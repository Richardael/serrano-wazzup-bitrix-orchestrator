# Serrano Wazzup-Bitrix Orchestrator environment example
# Copy to .env and provide every secret through Coolify or a secret manager.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

BITRIX24_WEBHOOK_BASE_URL=https://YOUR_PORTAL.bitrix24.com/rest/USER/SECRET
BITRIX24_DEFAULT_RESPONSIBLE_ID=1
BITRIX24_LEAD_INITIAL_STATUS=NEW
VENDOR_IDS=206,268,308

WAZZUP_WEBHOOK_ID=YOUR_WEBHOOK_ID
WAZZUP_WEBHOOK_BEARER_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
WAZZUP_API_KEY=YOUR_WAZZUP_API_KEY

BOT_INTERNAL_BASE_URL=http://localhost:3002
ORCHESTRATOR_SHARED_SECRET=GENERATE_A_LONG_RANDOM_SECRET

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

AUTOMATED_CHATBOT_ENABLED=false
STORE_MESSAGE_BODY=false
EVENT_RETENTION_DAYS=30
MAX_WEBHOOK_BODY_BYTES=1048576
JOB_MAX_ATTEMPTS=5
